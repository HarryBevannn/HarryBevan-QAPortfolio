---
/**
 * TestDesign: the "From requirement to test cases" demo, in four stages:
 * requirement, analysis, test cases and coverage (data in
 * src/data/testDesign.ts). Plain semantic HTML; when the column is narrow
 * (phones, and the desktop text column) the tables reflow into one card per
 * row, each cell labelled from data-label.
 */
import { analysis, coverage, criteria, story, testCases } from '../data/testDesign';

const automated = testCases.filter((t) => t.automatedBy.length > 0).length;
const p1 = testCases.filter((t) => t.priority === 'P1').length;
const covered = coverage.filter((c) => c.tests.length > 0).length;
---

<div class="td">
  <ol class="td__stages">
    <li class="td__stage panel" data-reveal>
      <p class="td__step mono">01 · Requirement</p>
      <h3 class="td__title">The user story</h3>
      <blockquote class="td__story">{story}</blockquote>
      <h4 class="td__label">Acceptance criteria</h4>
      <ul class="td__criteria">
        {criteria.map((ac) => (
          <li>
            <span class="td__id mono">{ac.id}</span>
            <span>{ac.text}</span>
          </li>
        ))}
      </ul>
    </li>

    <li class="td__stage panel" data-reveal>
      <p class="td__step mono">02 · Analysis</p>
      <h3 class="td__title">States, risks and techniques</h3>
      <h4 class="td__label">States</h4>
      <p class="td__states mono">
        {analysis.states.map((s, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> → </span>}
            <span class="td__state">{s}</span>
          </>
        ))}
      </p>
      <ul class="td__list">
        {analysis.transitions.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
      <h4 class="td__label">Risks</h4>
      <ul class="td__list">
        {analysis.risks.map((r) => (
          <li>{r}</li>
        ))}
      </ul>
      <h4 class="td__label">Techniques</h4>
      <ul class="chip-list" aria-label="Techniques">
        {analysis.techniques.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </li>

    <li class="td__stage panel" data-reveal>
      <p class="td__step mono">03 · Test cases</p>
      <h3 class="td__title">{testCases.length} prioritised test cases</h3>
      <p class="td__score">
        <span class="mono">{p1}</span> P1 · <span class="mono">{testCases.length - p1}</span> P2 ·
        each with its technique and the Playwright test that automates it
      </p>
      <details class="td__more">
        <summary data-testid="test-design-show-cases">
          See all {testCases.length} test cases
        </summary>
        <table class="td__table">
          <caption class="sr-only">Test cases for the start sequence</caption>
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Test case</th>
              <th scope="col">Covers</th>
              <th scope="col">Technique</th>
              <th scope="col">Priority</th>
              <th scope="col">Automated by</th>
            </tr>
          </thead>
          <tbody>
            {testCases.map((t) => (
              <tr data-test-case={t.id}>
                <th scope="row" class="mono" data-label="ID">
                  {t.id}
                </th>
                <td data-label="Test case">{t.title}</td>
                <td class="mono" data-label="Covers">
                  {t.covers.join(', ')}
                </td>
                <td data-label="Technique">{t.technique}</td>
                <td data-label="Priority">
                  <span class:list={['td__priority', `td__priority--${t.priority.toLowerCase()}`]}>
                    {t.priority}
                  </span>
                </td>
                <td data-label="Automated by">
                  <span class="td__auto">
                    {t.automatedBy.map((name) => (
                      <span class="td__test mono">✓ {name}</span>
                    ))}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </li>

    <li class="td__stage panel" data-reveal>
      <p class="td__step mono">04 · Coverage</p>
      <h3 class="td__title">Every criterion covered</h3>
      <p class="td__score">
        <span class="mono">
          {covered}/{criteria.length}
        </span>{' '}
        criteria covered ·
        <span class="mono">
          {automated}/{testCases.length}
        </span>{' '}
        test cases automated
      </p>
      <table class="td__table td__matrix">
        <caption class="sr-only">Which test cases cover each acceptance criterion</caption>
        <thead>
          <tr>
            <th scope="col">Criterion</th>
            <th scope="col">Covered by</th>
          </tr>
        </thead>
        <tbody>
          {coverage.map((c) => (
            <tr data-coverage={c.id}>
              <th scope="row" data-label="Criterion">
                <span>
                  <span class="td__id mono">{c.id}</span> {c.text}
                </span>
              </th>
              <td class="mono" data-label="Covered by">
                {c.tests.join(', ')}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="td__gap">
        The matrix exposed one gap: nothing tested a second press of START mid-sequence. TC-05 was
        added, along with its Playwright test, which now runs on every deploy.
      </p>
    </li>
  </ol>
  <p class="td__note">
    Demo: drafted by an AI agent from the requirement, then reviewed and edited by me, the way I’d
    run it on a real feature. The automated tests are this site’s own; their latest results are in
    the Telemetry panel above.
  </p>
</div>

<style>
  .td {
    container: td / inline-size;
    display: grid;
    gap: var(--space-4);
  }

  .td__stages {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .td__stage {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
  }

  .td__step {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .td__title {
    font-size: var(--text-xl);
  }

  .td__label {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-grey-200);
  }

  .td__story {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-red);
    background: rgb(255 255 255 / 4%);
    font-style: italic;
  }

  .td__criteria,
  .td__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .td__criteria li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-2);
  }

  .td__list li::before {
    content: '— ';
    color: var(--color-text-muted);
  }

  .td__id {
    font-weight: 700;
    color: var(--color-white);
  }

  .td__states {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }

  .td__state {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-carbon-500);
    border-radius: var(--radius-round);
    color: var(--color-white);
  }

  .td__more > summary {
    justify-self: start;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .td__more[open] > summary {
    margin-bottom: var(--space-3);
  }

  .td__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .td__table th,
  .td__table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-carbon-500);
    text-align: left;
    vertical-align: top;
  }

  .td__table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .td__table tbody th {
    font-weight: 400;
    color: var(--color-white);
  }

  .td__priority {
    justify-self: start;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .td__priority--p1 {
    background: rgb(225 6 0 / 18%);
    color: var(--color-red-bright);
  }

  .td__priority--p2 {
    background: rgb(255 176 0 / 15%);
    color: var(--color-amber);
  }

  .td__auto {
    display: grid;
    gap: var(--space-1);
  }

  .td__test {
    font-size: var(--text-xs);
    color: var(--color-green);
    overflow-wrap: anywhere;
  }

  .td__score {
    color: var(--color-text-muted);
  }

  .td__score .mono {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-green);
  }

  .td__gap,
  .td__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .td__gap {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-amber);
    background: rgb(255 176 0 / 6%);
  }

  /* Narrow columns: each table row becomes a card, every cell labelled. */
  @container td (max-width: 760px) {
    .td__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .td__table,
    .td__table tbody,
    .td__table tr,
    .td__table th,
    .td__table td {
      display: block;
    }

    .td__table tr {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--color-carbon-500);
    }

    .td__table th,
    .td__table td {
      display: grid;
      grid-template-columns: 6.5rem 1fr;
      gap: var(--space-2);
      padding: var(--space-1) 0;
      border: 0;
    }

    .td__table th::before,
    .td__table td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-muted);
    }
  }
</style>
