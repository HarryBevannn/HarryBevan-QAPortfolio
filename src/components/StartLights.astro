---
/**
 * StartLights: a gantry of five start lights across the top of the screen.
 * Each pod has two lamps with a red and a green glow layer. engineStart.ts
 * lights the reds one by one, holds, then switches all five to green for "go".
 */
const pods = Array.from({ length: 5 }, (_, i) => i);
---

<div class="start-lights" aria-hidden="true">
  <div class="start-lights__gantry">
    {pods.map(() => (
      <div class="start-lights__pod" data-start-light>
        <span class="start-lights__lamp">
          <span class="start-lights__glow" data-glow="red" />
          <span class="start-lights__glow start-lights__glow--green" data-glow="green" />
        </span>
        <span class="start-lights__lamp">
          <span class="start-lights__glow" data-glow="red" />
          <span class="start-lights__glow start-lights__glow--green" data-glow="green" />
        </span>
      </div>
    ))}
  </div>
</div>

<style>
  /* Positioned by StartScreen, beneath the title. */
  .start-lights {
    position: relative;
  }

  .start-lights__gantry {
    display: flex;
    gap: clamp(0.4rem, 1.6vw, 1rem);
    padding: clamp(0.4rem, 1.2vw, 0.7rem);
    border-radius: var(--radius-md);
    background: linear-gradient(#1f2125, #0a0a0b);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 8%),
      0 8px 24px rgb(0 0 0 / 60%);
  }

  .start-lights__pod {
    display: grid;
    gap: clamp(0.25rem, 0.8vw, 0.45rem);
    padding: clamp(0.25rem, 0.8vw, 0.45rem);
    border-radius: var(--radius-sm);
    background: #050506;
  }

  .start-lights__lamp {
    position: relative;
    display: block;
    width: clamp(1.25rem, 4.2vw, 2.25rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #2b1110, #120707 70%);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 80%);
  }

  .start-lights__glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #ffd2cc, #ff3b30 30%, #e10600 62%, #8f0400);
    box-shadow:
      0 0 14px 4px var(--color-red-glow),
      0 0 40px 10px rgb(225 6 0 / 30%);
    opacity: 0;
  }

  .start-lights__glow--green {
    background: radial-gradient(circle at 40% 35%, #d9ffe9, #3ddc84 32%, #12a150 64%, #06512a);
    box-shadow:
      0 0 14px 4px rgb(61 220 132 / 55%),
      0 0 40px 10px rgb(61 220 132 / 30%);
  }
</style>
