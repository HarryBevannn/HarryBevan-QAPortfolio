---
/**
 * DriverView: the visitor's seat in the car. A fixed layer behind the CV with
 * the road ahead (a canvas drawn by src/animations/road.ts), an original
 * open-wheel cockpit on top, speed streaks and a scrim that keeps the CV copy
 * readable.
 *
 * The cockpit (original design, generic red livery): the nose running out to
 * the front wing, both front tyres on their wishbones and pushrods, the
 * cockpit sides with mirrors on stalks, and a race wheel with grips, gloved
 * hands, a gear display and rev LEDs.
 *
 * JS only and decorative: without JS the CV reads as a plain page and the
 * top-down map at the finish (LapReview) shows the circuit instead.
 *
 * Hooks for src/animations/lap.ts:
 *   [data-driver]         the layer; --driver-cx places the vanishing point
 *   [data-road]           the canvas; data-boards = gantries, corner boards, stands
 *   [data-driver-wheel]   steering wheel group, rotated with the bends
 *   [data-driver-tyre]    front tyres, steered a little with the wheel
 *   [data-driver-hub]     the mount round each tyre ("left"/"right"): "Break it"
 *                         (src/animations/crash.ts) throws the left one off
 *   [data-driver-gear]    the gear display ("!" while the car is broken)
 *   [data-driver-sparks]  sparks from the crash, hidden until then
 *                         (data-cx/data-cy: the point they turn about)
 *   [data-driver-led]     rev LEDs, lit with scroll speed
 *   [data-driver-frame]   the cockpit frame (fades out on the pull-up)
 */
import { lap } from '../data/lap';
import { corners, progressOf } from '../data/track';
import type { RoadBoard } from '../animations/road';

/**
 * Grandstands round the circuit: the main stand along the start/finish
 * straight, and one on the outside of each big corner. Lengths are in track
 * plan units; `side` (1 = right of the car) defaults to the outside of the bend.
 */
const stands: { waypoint: string; len: number; side?: 1 | -1 }[] = [
  { waypoint: 'start', len: 260, side: 1 },
  { waypoint: 't1', len: 110 },
  { waypoint: 't4', len: 90 },
  { waypoint: 't6', len: 130 },
  { waypoint: 'esses', len: 100 },
  { waypoint: 't10', len: 130 },
  { waypoint: 't12', len: 100 },
];

const boards: RoadBoard[] = [
  ...lap
    .map((s, i) => ({ s, i }))
    .filter(({ s }) => !s.hero && s.waypoint !== 'finish')
    .map(({ s, i }) => ({
      p: progressOf(s.waypoint),
      kind: 'gantry' as const,
      num: String(i + 1).padStart(2, '0'),
      title: s.title,
    })),
  ...corners.map((c) => ({
    p: progressOf(c.waypoint),
    kind: 'corner' as const,
    num: c.label.toUpperCase(),
    title: '',
  })),
  ...stands.map((s) => ({
    p: progressOf(s.waypoint),
    kind: 'stand' as const,
    num: '',
    title: '',
    len: s.len,
    ...(s.side ? { side: s.side } : {}),
  })),
];

// Presentation attributes can't read CSS variables, so mirror theme.css here.
const C = { red: '#e10600', amber: '#ffb000', green: '#3ddc84', blue: '#2b6cff' };

// Rev LEDs in a shallow arc across the top of the wheel.
const leds = Array.from({ length: 15 }, (_, i) => {
  const t = i / 14;
  return {
    x: +(652 + 296 * t).toFixed(1),
    y: +(762 - Math.sin(t * Math.PI) * 8).toFixed(1),
    colour: i < 5 ? C.green : i < 10 ? C.amber : C.red,
  };
});

// The two front tyres (left; the right one is mirrored about x = 800).
const TYRE = { x: 190, y: 560, w: 250, h: 330, hubX: 432, hubY: 742 };
const mirror = (x: number) => 1600 - x;
---

<div class="driver" data-driver aria-hidden="true">
  <canvas class="driver__road" data-road data-boards={JSON.stringify(boards)}></canvas>
  <div class="driver__rush"></div>
  <div class="driver__scrim"></div>

  <div class="driver__frame" data-driver-frame>
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax meet" focusable="false">
      <defs>
        <linearGradient id="dv-carbon" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3a3e45"></stop>
          <stop offset="0.35" stop-color="#1a1c20"></stop>
          <stop offset="1" stop-color="#08090a"></stop>
        </linearGradient>
        <pattern id="dv-weave" width="10" height="10" patternUnits="userSpaceOnUse">
          <rect width="10" height="10" fill="#15171a"></rect>
          <rect width="5" height="5" fill="#1f2226"></rect>
          <rect x="5" y="5" width="5" height="5" fill="#1f2226"></rect>
        </pattern>
        <linearGradient id="dv-body" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#6e0300"></stop>
          <stop offset="0.3" stop-color="#c00500"></stop>
          <stop offset="0.47" stop-color="#ff4a3d"></stop>
          <stop offset="0.53" stop-color="#ff4a3d"></stop>
          <stop offset="0.7" stop-color="#c00500"></stop>
          <stop offset="1" stop-color="#6e0300"></stop>
        </linearGradient>
        <linearGradient id="dv-body-side" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ff3b30"></stop>
          <stop offset="0.3" stop-color="#d10500"></stop>
          <stop offset="1" stop-color="#5a0200"></stop>
        </linearGradient>
        <linearGradient id="dv-tread" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#3c3f45"></stop>
          <stop offset="0.25" stop-color="#202226"></stop>
          <stop offset="1" stop-color="#0b0c0e"></stop>
        </linearGradient>
        <linearGradient id="dv-tread-shine" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="#fff" stop-opacity="0.16"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </linearGradient>
        <radialGradient id="dv-rim" cx="0.4" cy="0.4" r="0.7">
          <stop offset="0" stop-color="#e9ebee"></stop>
          <stop offset="0.6" stop-color="#8d939b"></stop>
          <stop offset="1" stop-color="#3b3f45"></stop>
        </radialGradient>
        <linearGradient id="dv-arm" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#4a4f57"></stop>
          <stop offset="0.5" stop-color="#1c1e22"></stop>
          <stop offset="1" stop-color="#0c0d0f"></stop>
        </linearGradient>
        <linearGradient id="dv-mirror" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#8fc3ec"></stop>
          <stop offset="0.6" stop-color="#d6ebf8"></stop>
          <stop offset="0.61" stop-color="#5f8a4c"></stop>
          <stop offset="1" stop-color="#4f7a3e"></stop>
        </linearGradient>
        <linearGradient id="dv-glove" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f5f6f7"></stop>
          <stop offset="0.55" stop-color="#c9ced6"></stop>
          <stop offset="1" stop-color="#7d848e"></stop>
        </linearGradient>
        <g id="dv-tyre">
          <!-- Tread: the top of the tyre, with a soft sheen -->
          <rect
            x={TYRE.x}
            y={TYRE.y}
            width={TYRE.w}
            height={TYRE.h}
            rx="70"
            fill="url(#dv-tread)"
          ></rect>
          <rect
            x={TYRE.x + 20}
            y={TYRE.y + 6}
            width={TYRE.w - 40}
            height="70"
            rx="40"
            fill="url(#dv-tread-shine)"
          ></rect>
          <!-- Inner sidewall, facing the nose: compound stripe, rim, brake duct -->
          <ellipse cx={TYRE.hubX} cy={TYRE.hubY} rx="44" ry="168" fill="#111214"></ellipse>
          <ellipse
            cx={TYRE.hubX}
            cy={TYRE.hubY}
            rx="36"
            ry="138"
            fill="none"
            stroke="#ffb000"
            stroke-width="5"
          ></ellipse>
          <ellipse cx={TYRE.hubX} cy={TYRE.hubY} rx="28" ry="108" fill="url(#dv-rim)"></ellipse>
          <ellipse
            cx={TYRE.hubX + 4}
            cy={TYRE.hubY}
            rx="18"
            ry="72"
            fill="url(#dv-weave)"
          ></ellipse>
          <ellipse
            cx={TYRE.hubX + 4}
            cy={TYRE.hubY}
            rx="18"
            ry="72"
            fill="none"
            stroke="#5b5f66"
            stroke-width="3"
          ></ellipse>
        </g>
        <g id="dv-arms">
          <!-- Upper and lower wishbones, and the pushrod, from the nose to the hub -->
          <path d="M716 690 L448 700 L448 716 L722 712 Z" fill="url(#dv-arm)"></path>
          <path d="M702 770 L448 790 L448 806 L706 794 Z" fill="url(#dv-arm)"></path>
          <path d="M448 798 L700 700 L708 712 L452 812 Z" fill="#202328"></path>
          <rect x="436" y="684" width="22" height="134" rx="8" fill="#2a2d33"></rect>
        </g>
      </defs>

      <!-- Front wing, far out past the nose tip -->
      <path d="M540 592 Q800 576 1060 592 L1060 606 Q800 594 540 606 Z" fill="#16181c"></path>
      <path d="M540 588 h14 v30 h-14 Z M1046 588 h14 v30 h-14 Z" fill={C.red}></path>

      <!-- Front tyres, steered with the wheel; each on a hub mount the crash can move -->
      <g data-driver-hub="left">
        <g data-driver-tyre data-cx={TYRE.x + TYRE.w / 2} data-cy={TYRE.y + TYRE.h / 2}>
          <use href="#dv-tyre"></use>
        </g>
      </g>
      <g data-driver-hub="right">
        <g data-driver-tyre data-cx={mirror(TYRE.x + TYRE.w / 2)} data-cy={TYRE.y + TYRE.h / 2}>
          <use href="#dv-tyre" transform="translate(1600 0) scale(-1 1)"></use>
        </g>
      </g>

      <!-- Suspension (the left side droops when its wheel comes off) -->
      <g data-driver-arm="left">
        <use href="#dv-arms"></use>
      </g>
      <use href="#dv-arms" transform="translate(1600 0) scale(-1 1)"></use>

      <!-- Sparks where the left hub scrapes the road, shown only by the crash -->
      <g data-driver-sparks opacity="0">
        {[
          [440, 860, 330, 760],
          [450, 870, 300, 830],
          [438, 850, 360, 700],
          [460, 880, 380, 900],
          [445, 865, 270, 790],
        ].map(([x1, y1, x2, y2]) => (
          <line
            x1={x1}
            y1={y1}
            x2={x2}
            y2={y2}
            stroke="#ffd23f"
            stroke-width="5"
            stroke-linecap="round"
          />
        ))}
      </g>

      <!-- Nose: red bodywork with a white pinstripe and a carbon top panel -->
      <path
        d="M606 900 C640 790 714 652 764 586 Q800 560 836 586 C886 652 960 790 994 900 Z"
        fill="url(#dv-body)"
      ></path>
      <path
        d="M770 900 C776 780 786 650 792 590 Q800 584 808 590 C814 650 824 780 830 900 Z"
        fill="url(#dv-weave)"
        opacity="0.9"
      ></path>
      <path
        d="M764 900 C770 780 782 650 788 590 M836 900 C830 780 818 650 812 590"
        fill="none"
        stroke="#f5f6f7"
        stroke-width="3"
        stroke-opacity="0.8"
      ></path>
      <path
        d="M764 586 Q800 560 836 586"
        fill="none"
        stroke="#ffffff"
        stroke-opacity="0.45"
        stroke-width="3"
      ></path>

      <!-- Cockpit sides, with mirrors on stalks -->
      <path
        d="M-6000 900 V700 H0 Q150 712 250 790 Q300 836 316 900 Z"
        fill="url(#dv-body-side)"
      ></path>
      <path
        d="M7600 900 V700 H1600 Q1450 712 1350 790 Q1300 836 1284 900 Z"
        fill="url(#dv-body-side)"
      ></path>
      <path
        d="M-6000 760 H0 Q170 772 270 862 L280 900 H-6000 Z M7600 760 H1600 Q1430 772 1330 862 L1320 900 H7600 Z"
        fill="url(#dv-weave)"
      ></path>
      <g>
        <path d="M150 740 L176 640 L190 642 L170 744 Z" fill="#1a1c20"></path>
        <rect x="70" y="580" width="190" height="72" rx="20" fill="url(#dv-body-side)"></rect>
        <rect x="84" y="592" width="162" height="48" rx="12" fill="url(#dv-mirror)"></rect>
        <path d="M1450 740 L1424 640 L1410 642 L1430 744 Z" fill="#1a1c20"></path>
        <rect x="1340" y="580" width="190" height="72" rx="20" fill="url(#dv-body-side)"></rect>
        <rect x="1354" y="592" width="162" height="48" rx="12" fill="url(#dv-mirror)"></rect>
      </g>

      <!-- Steering wheel: grips, gloved hands, display, buttons and rev LEDs -->
      <g data-driver-wheel>
        <path
          d="M560 900 L574 800 Q586 746 640 742 L960 742 Q1014 746 1026 800 L1040 900 Z"
          fill="url(#dv-carbon)"
        ></path>
        <path
          d="M560 900 L574 800 Q586 746 640 742 L960 742 Q1014 746 1026 800 L1040 900 Z"
          fill="none"
          stroke="#4a4f57"
          stroke-width="3"
        ></path>
        <rect x="520" y="770" width="86" height="160" rx="36" fill="#151618"></rect>
        <rect x="994" y="770" width="86" height="160" rx="36" fill="#151618"></rect>
        <!-- Gloves wrapped round the grips -->
        <g fill="url(#dv-glove)" stroke="#5d646e" stroke-width="2">
          <path d="M500 800 Q498 768 530 764 L590 768 Q616 774 614 806 L612 880 Q600 900 560 900 L520 900 Q498 880 500 840 Z"></path>
          <path d="M1100 800 Q1102 768 1070 764 L1010 768 Q984 774 986 806 L988 880 Q1000 900 1040 900 L1080 900 Q1102 880 1100 840 Z"></path>
        </g>
        <g stroke="#7d848e" stroke-width="2" fill="none">
          <path d="M590 790 h22 M590 815 h22 M590 840 h22 M1010 790 h-22 M1010 815 h-22 M1010 840 h-22"></path>
        </g>
        <path d="M506 820 h30 M1094 820 h-30" stroke={C.red} stroke-width="8"></path>
        <!-- Display -->
        <rect x="705" y="780" width="190" height="78" rx="8" fill="#050607" stroke="#3a3d43"></rect>
        <text x="800" y="836" class="driver__gear" text-anchor="middle" data-driver-gear>
          7
        </text>
        <rect x="716" y="790" width="40" height="6" rx="2" fill={C.green}></rect>
        <rect x="844" y="790" width="40" height="6" rx="2" fill={C.amber}></rect>
        <!-- Buttons and rotaries -->
        <circle cx="660" cy="800" r="13" fill={C.red} stroke="#0b0c0e" stroke-width="3"></circle>
        <circle cx="940" cy="800" r="13" fill={C.blue} stroke="#0b0c0e" stroke-width="3"></circle>
        <circle cx="660" cy="848" r="11" fill="#f5f6f7" stroke="#0b0c0e" stroke-width="3"></circle>
        <circle cx="940" cy="848" r="11" fill={C.amber} stroke="#0b0c0e" stroke-width="3"></circle>
        <g fill="#2a2d33" stroke="#9aa0a8" stroke-width="2">
          <circle cx="740" cy="884" r="14"></circle>
          <circle cx="800" cy="884" r="14"></circle>
          <circle cx="860" cy="884" r="14"></circle>
        </g>
        {leds.map((led) => (
          <g>
            <circle cx={led.x} cy={led.y} r="9" fill="#050506" stroke="#2a2c31" stroke-width="2" />
            <circle cx={led.x} cy={led.y} r="7" fill={led.colour} opacity="0" data-driver-led />
          </g>
        ))}
      </g>
    </svg>
  </div>
</div>

<style>
  .driver {
    display: none;
  }

  /* JS only, and only once the car is running (the start screen covers it before). */
  :global(html.js:is([data-stage='starting'], [data-stage='track'])) .driver {
    --driver-cx: 50%;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    overflow: hidden;
    pointer-events: none;
    background: var(--color-bg);
  }

  .driver__road {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Speed streaks rushing out from the vanishing point; opacity follows scroll speed. */
  .driver__rush {
    position: absolute;
    inset: 0;
    opacity: calc(var(--lap-speed, 0) * 0.7);
    background: repeating-conic-gradient(
      from 0deg at var(--driver-cx) 42%,
      transparent 0deg 5deg,
      rgb(255 255 255 / 9%) 5deg 5.4deg,
      transparent 5.4deg 11deg,
      rgb(126 224 255 / 10%) 11deg 11.3deg
    );
    mask-image: radial-gradient(circle at var(--driver-cx) 42%, transparent 0 18%, #000 55%);
  }

  /* The cockpit frame is centred on the vanishing point, wider than the screen. */
  /*
   * Mobile: the view is a windscreen band across the top of the screen (the
   * mini-map bar sits on its sky). It's drawn above the page, so text scrolls
   * up underneath it and never runs across the road or the wheel; a kerb
   * stripe marks its lower edge.
   */
  @media (max-width: 899px) {
    :global(html.js:is([data-stage='starting'], [data-stage='track'])) .driver {
      bottom: auto;
      z-index: var(--z-windscreen);
      height: var(--windscreen-h);
      box-shadow: 0 12px 28px -10px rgb(0 0 0 / 85%);
    }

    .driver::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      z-index: 3;
      height: 4px;
      background: var(--kerb-straight);
    }
  }

  .driver__frame {
    position: absolute;
    bottom: 0;
    /*
     * Sized by the view's height so the car keeps its proportions on any
     * screen shape; the cockpit sides run on past the edges (overflow).
     */
    --frame-h: calc(var(--windscreen-h) * 0.78);
    left: calc(var(--driver-cx) - var(--frame-h) * 8 / 9);
    width: calc(var(--frame-h) * 16 / 9);
    height: var(--frame-h);
  }

  .driver__frame svg {
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }

  .driver__gear {
    font-family: var(--font-mono);
    font-size: 46px;
    font-weight: 700;
    fill: var(--color-white);
  }

  /* Mobile: the text has its own space below, so only shade the band's foot. */
  .driver__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 75%, rgb(10 11 13 / 35%));
  }

  .driver__frame {
    z-index: 2;
  }

  /* Desktop: the CV column on the left gets a dark scrim; the road stays clear on the right. */
  @media (min-width: 900px) {
    :global(html.js:is([data-stage='starting'], [data-stage='track'])) .driver {
      --driver-cx: 62%;
    }

    .driver__scrim {
      background: linear-gradient(
        90deg,
        rgb(10 11 13 / 94%) 0%,
        rgb(10 11 13 / 88%) 36%,
        rgb(10 11 13 / 30%) 50%,
        transparent 58%
      );
    }

    .driver__frame {
      --frame-h: 62vh;
      z-index: 0;
    }
  }

  /* Wide desktop: the text column is wider (index.astro), so the car and the scrim's edge move right. */
  @media (min-width: 1400px) {
    :global(html.js:is([data-stage='starting'], [data-stage='track'])) .driver {
      --driver-cx: 68%;
    }

    .driver__scrim {
      background: linear-gradient(
        90deg,
        rgb(10 11 13 / 94%) 0%,
        rgb(10 11 13 / 88%) 44%,
        rgb(10 11 13 / 30%) 56%,
        transparent 64%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .driver__rush {
      display: none;
    }
  }
</style>
