---
/**
 * LapSection: one CV section, tied to a point on the lap.
 * Content comes from src/data/lap.ts; blocks render via LapBlock.astro.
 * Plain semantic HTML, so it reads well with or without JavaScript.
 */
import LapBlock from './LapBlock.astro';
import type { LapSectionData } from '../data/lap';
import { progressOf } from '../data/track';
import { site } from '../data/site';
import { metrics } from '../data/metrics';

interface Props {
  section: LapSectionData;
  index: number;
  /** The hero's "Scroll to drive" cue jumps here (the next section). */
  nextId?: string;
}

const { section, index, nextId } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const headingId = `${section.id}-heading`;
const progress = progressOf(section.waypoint).toFixed(4);
const [firstName, ...rest] = site.name.split(' ');
const heroStats = metrics.slice(0, 3);
const heroAttr = section.hero ? { 'data-hero-role': '' } : {};
---

<section
  id={section.id}
  class:list={['lap-section', { 'lap-section--hero': section.hero }]}
  aria-labelledby={headingId}
  data-lap-section
  data-progress={progress}
  data-sector={section.sector}
>
  {!section.hero && (
    <span class="lap-section__ghost" aria-hidden="true">
      {number}
    </span>
  )}

  <header class="lap-section__head" {...(section.hero ? {} : { 'data-reveal': '' })}>
    <p class="eyebrow lap-section__sector" {...heroAttr}>
      <span class="lap-section__num">{number}</span>
      {section.sector}
      {section.hero && <span class="lap-section__pole">· Pole position</span>}
    </p>

    {section.hero ? (
      <>
        <h1 id={headingId} class="hero__title" tabindex="-1" data-hero-title>
          <span class="hero__word">
            <span data-hero-word>{firstName}</span>
          </span>{' '}
          <span class="hero__word">
            <span class="hero__outline" data-hero-word>
              {rest.join(' ')}
            </span>
          </span>
        </h1>
        <p class="hero__role" data-hero-role>
          <span class="hero__role-bar" aria-hidden="true" />
          {site.role}
        </p>
      </>
    ) : (
      <h2 id={headingId} class="lap-section__title">
        {section.title}
      </h2>
    )}

    {section.intro && (
      <p class:list={['lap-section__intro', { hero__intro: section.hero }]} {...heroAttr}>
        {section.intro}
      </p>
    )}
  </header>

  {section.hero && (
    <dl class="hero__stats" data-hero-role>
      {heroStats.map((m) => (
        <div class="hero__stat">
          <dt>{m.label}</dt>
          <dd class="mono">
            {m.prefix}
            {m.value}
            {m.suffix}
          </dd>
        </div>
      ))}
    </dl>
  )}

  <div class="lap-section__blocks" {...heroAttr}>
    {section.blocks.map((block) => (
      <LapBlock block={block} />
    ))}
  </div>

  {section.hero && (
    <div class="hero__ctas" data-hero-cue>
      <a class="hero__cue" href={`#${nextId ?? 'main'}`} data-testid="hero-scroll-cue">
        <span class="hero__cue-icon" aria-hidden="true" />
        Scroll to drive
      </a>
      <a class="hero__contact" href="#contact" data-testid="hero-contact">
        Get in touch
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )}
</section>

<style>
  .lap-section {
    position: relative;
    display: grid;
    gap: var(--space-5);
    align-content: center;
    max-width: var(--content-max);
    padding-block: var(--space-8);
    scroll-margin-top: calc(var(--minimap-height) + var(--space-4));
  }

  /* Mobile, in the car: the html scroll-padding already clears the windscreen. */
  @media (max-width: 899px) {
    :global(html.js[data-stage='track']) .lap-section {
      scroll-margin-top: 0;
    }
  }

  .lap-section__ghost {
    position: absolute;
    top: var(--space-5);
    right: 0;
    z-index: -1;
    font-family: var(--font-mono);
    font-size: clamp(6rem, 4rem + 10vw, 11rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 9%);
    user-select: none;
  }

  .lap-section:global(.is-active) .lap-section__ghost {
    -webkit-text-stroke-color: rgb(225 6 0 / 35%);
  }

  .lap-section__head {
    display: grid;
    gap: var(--space-3);
  }

  .lap-section__sector {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-grey-200);
  }

  .lap-section__num {
    display: inline-grid;
    place-items: center;
    min-width: 2.4em;
    height: 2.4em;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-white);
    transition:
      background-color var(--duration-base),
      border-color var(--duration-base);
  }

  .lap-section:global(.is-active) .lap-section__num {
    border-color: var(--color-white);
    background: var(--color-red);
    box-shadow: 0 0 18px -2px var(--color-red-glow);
  }

  .lap-section__pole {
    color: var(--color-text-muted);
  }

  .lap-section__title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
    letter-spacing: -0.02em;
  }

  /* Kerb flash under each section title. */
  .lap-section__title::after {
    content: '';
    display: block;
    width: 4.5rem;
    height: 6px;
    margin-top: var(--space-3);
    border-radius: 3px;
    background: var(--kerb-straight);
  }

  /*
   * Scroll effects (html.lap-fx is set by lap.ts, never under reduced motion):
   * the title wipes in left to right and its kerb stripe shoots out after it.
   */
  :global(html.lap-fx) .lap-section__title {
    clip-path: inset(-0.2em 100% -0.4em 0);
    transition: clip-path 0.9s var(--ease-out) 0.1s;
  }

  :global(html.lap-fx) .lap-section__title::after {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out) 0.55s;
  }

  :global(html.lap-fx) .lap-section:global(.is-in) .lap-section__title {
    clip-path: inset(-0.2em -1em -0.4em 0);
  }

  :global(html.lap-fx) .lap-section:global(.is-in) .lap-section__title::after {
    transform: none;
  }

  .lap-section__intro {
    font-size: var(--text-lg);
    color: var(--color-grey-200);
  }

  .lap-section__blocks {
    display: grid;
    gap: var(--space-6);
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .lap-section--hero {
    padding-block: var(--space-5) var(--space-8);
  }

  .hero__title {
    font-size: clamp(3.25rem, 2rem + 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .hero__word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    vertical-align: bottom;
  }

  .hero__word > span {
    display: inline-block;
  }

  /* "Bevan" in outline, with a red sheen sweeping through it. */
  .hero__outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-white);
    background: linear-gradient(100deg, transparent 30%, rgb(225 6 0 / 85%) 50%, transparent 70%);
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: sheen 5s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    30% {
      background-position: 120% 0;
    }
    70%,
    100% {
      background-position: -20% 0;
    }
  }

  .hero__role {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-red-bright);
  }

  .hero__role-bar {
    flex: none;
    width: 2rem;
    height: 6px;
    border-radius: 3px;
    background: var(--kerb-straight);
  }

  .hero__intro {
    max-width: 34rem;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .hero__stat dd {
    margin: 0;
    white-space: nowrap;
    font-size: clamp(1.05rem, 0.75rem + 1.6vw, 1.75rem);
    font-weight: 700;
    color: var(--color-white);
  }

  .hero__stat dt {
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3rem;
    padding: 0 var(--space-5) 0 var(--space-3);
    border-radius: var(--radius-round);
    background: var(--color-red);
    box-shadow: var(--shadow-glow-red);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
  }

  .hero__cue:hover {
    background: #ff1a10;
    color: var(--color-white);
  }

  .hero__cue-icon {
    position: relative;
    width: 1.2rem;
    height: 1.9rem;
    border: 2px solid var(--color-white);
    border-radius: var(--radius-round);
  }

  .hero__cue-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.3rem;
    width: 4px;
    height: 7px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-white);
    animation: cue-scroll 1.8s var(--ease-out) infinite;
  }

  @keyframes cue-scroll {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80%,
    100% {
      transform: translateY(0.7rem);
      opacity: 0;
    }
  }

  .hero__contact {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-round);
    background: rgb(255 255 255 / 5%);
    color: var(--color-white);
    font-weight: 700;
    text-decoration: none;
  }

  .hero__contact:hover {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  @media (min-width: 900px) {
    .lap-section {
      min-height: 100vh;
      padding-block: var(--space-9);
    }

    .lap-section--hero {
      min-height: 100vh;
    }
  }
</style>
